<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <exclude domain="file" path="auto_backups/" />
        <exclude domain="file" path="supernova_crash.log" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <exclude domain="file" path="auto_backups/" />
        <exclude domain="file" path="supernova_crash.log" />
    </device-transfer>
</data-extraction-rules>
